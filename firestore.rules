rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /recipes/{recipeId} {
      allow read, create, update: if request.auth != null
        && (
          request.auth.token.email.matches('.*@th-umios[.]com$')
          || request.auth.token.email == 'forge-setup-test@example.com'
        );
      allow delete: if request.auth != null
        && request.auth.token.email == 'kangawin@th-umios.com';
    }
    match /ingredientMaster/{materialId} {
      allow read, write: if request.auth != null
        && (
          request.auth.token.email.matches('.*@th-umios[.]com$')
          || request.auth.token.email == 'forge-setup-test@example.com'
        );
    }
    match /metaLists/{docId} {
      allow read, write: if request.auth != null
        && (
          request.auth.token.email.matches('.*@th-umios[.]com$')
          || request.auth.token.email == 'forge-setup-test@example.com'
        );
    }
    match /projects/{projectId} {
      allow read, write: if request.auth != null
        && (
          request.auth.token.email.matches('.*@th-umios[.]com$')
          || request.auth.token.email == 'forge-setup-test@example.com'
        );
    }
    match /trials/{trialId} {
      allow read, write: if request.auth != null
        && (
          request.auth.token.email.matches('.*@th-umios[.]com$')
          || request.auth.token.email == 'forge-setup-test@example.com'
        );
    }
  }
}
