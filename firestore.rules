rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Shared helpers ----------
    function isOrgEmail() {
      return request.auth.token.email.matches('.*@th-umios[.]com$')
        || request.auth.token.email == 'forge-setup-test@example.com';
    }
    // The one account that can delete recipes/materials, approve new
    // sign-ups, and reset a member's password — same person as
    // DELETE_APPROVER_EMAIL in index.html, kept in sync manually since
    // rules and app code can't share a constant.
    function isAdmin() {
      return request.auth.token.email == 'kangawin@th-umios.com';
    }
    // A signed-up account only gets real data access once its own
    // userApprovals doc says so — admin and the test account bypass this
    // (the admin in particular must never be able to lock themselves out
    // by being unapproved).
    function isApproved() {
      return exists(/databases/$(database)/documents/userApprovals/$(request.auth.uid))
        && get(/databases/$(database)/documents/userApprovals/$(request.auth.uid)).data.status == 'approved';
    }
    function isAllowedUser() {
      return request.auth != null && isOrgEmail()
        && (isAdmin() || request.auth.token.email == 'forge-setup-test@example.com' || isApproved());
    }

    match /recipes/{recipeId} {
      allow read, create, update: if isAllowedUser();
      allow delete: if request.auth != null && isAdmin();
    }
    // One doc per Recipe Series (see recipeSeriesCol in app.js), holding
    // the atomic Trial-number counter "+ New Trial" reads and increments
    // inside a runTransaction. Any approved user can create/update, same
    // shape as /recipes above — this has to stay non-admin-restricted
    // since New Trial (an everyday action) writes here too, not just the
    // admin-only Series migration tool. Only deletion is admin-only,
    // matching every other collection's own delete rule in this file.
    match /recipeSeries/{seriesId} {
      allow read, create, update: if isAllowedUser();
      allow delete: if request.auth != null && isAdmin();
    }
    match /ingredientMaster/{materialId} {
      allow read, write: if isAllowedUser();
    }
    match /productList/{productId} {
      allow read, write: if isAllowedUser();
    }
    match /metaLists/{docId} {
      allow read, write: if isAllowedUser();
    }
    match /projects/{projectId} {
      allow read, write: if isAllowedUser();
    }
    match /trials/{trialId} {
      allow read, write: if isAllowedUser();
    }
    // One saved Compare Trials picker set per Recipe Series (id = seriesId)
    // -- see compareSetsCol in app.js. Same access level as /trials itself.
    match /compareSets/{seriesId} {
      allow read, write: if isAllowedUser();
    }
    match /sampleSubmissions/{submissionId} {
      allow read, write: if isAllowedUser();
    }
    // A full snapshot of a deleted Recipe/Ingredient/Product/Project/Trial/
    // Sample Submission, kept for 30 days so a delete can be undone from
    // the Trash screen (see moveToTrash/restoreFromTrash in app.js) --
    // same access level as the entities it holds snapshots of. No update
    // rule: a Trash entry is only ever created once and later deleted
    // (restored or expired), never edited in place.
    match /trash/{trashId} {
      allow read, create, delete: if isAllowedUser();
    }
    // Atomic per-year Form No. counter (id = "2026", field maxSeq) that
    // issueSubmissionFormNo()'s runTransaction() reads and increments —
    // same access level as /sampleSubmissions itself, since only that
    // transaction ever touches this collection.
    match /sampleSubmissionCounters/{year} {
      allow read, write: if isAllowedUser();
    }
    // Append-only sign-in audit log: any team member can read the whole
    // log (shown via the notification bell), but a client can only ever
    // create an event for its own account — never someone else's — and
    // can never update or delete an entry once written.
    match /loginEvents/{eventId} {
      allow read: if isAllowedUser();
      allow create: if request.auth != null && isOrgEmail()
        && request.resource.data.email == request.auth.token.email;
    }
    // One doc per Firebase Auth account (keyed by uid), tracking whether an
    // admin has approved them to actually use the app yet. A brand-new
    // account can create its own doc (pending only — never approved,
    // that'd be self-approval) so the sign-up flow can record the request;
    // after that only the admin can move it to approved/rejected. Every
    // account can read its own doc (to know whether it's still waiting),
    // and the admin can read all of them (to see who's pending).
    match /userApprovals/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email;
      allow update: if request.auth != null && isAdmin();
      allow delete: if false;
    }
    // My Profile — display name + photo, one doc per account. Readable by
    // any signed-in team member (so a future feature could show a
    // colleague's nice name/photo instead of just their email), writable
    // only by the account it belongs to.
    match /userProfiles/{uid} {
      allow read: if isAllowedUser();
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Just a heartbeat timestamp per account, for the navbar's "who's
    // online" avatar cluster (see attachPresenceListeners/
    // sendPresenceHeartbeat in app.js). Same read-all/write-own shape as
    // userProfiles right above, for the same reason -- everyone needs to
    // see everyone else's, but only the owning account can ever update its
    // own.
    match /presence/{uid} {
      allow read: if isAllowedUser();
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Append-only add/edit/delete activity log (Recipes, Projects, Trials,
    // Ingredients) — merged with loginEvents in the notification bell.
    // Every logActivityEvent() call site only runs from inside an action
    // an approved user just took, so this can require isAllowedUser() for
    // create (stricter than loginEvents' isOrgEmail(), which has to allow
    // a still-pending account to log its own very first sign-in).
    match /activityEvents/{eventId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser() && request.resource.data.by == request.auth.token.email;
      allow update, delete: if false;
    }
    // Draft project submissions from the public, no-login "share a link"
    // intake page (see submit.html) — each doc is keyed by a long random
    // token generated client-side (192 bits, not derivable or enumerable),
    // so read/write access here is deliberately NOT gated on request.auth
    // at all; the token itself, not a login, is what proves someone has
    // the right to touch a given submission. Kept in its own collection
    // (never merged into /projects) so this open-by-design write path can
    // never reach real company project data — a submission only becomes a
    // real project when a signed-in team member reviews and imports it
    // from inside the app. submissionStatus ('pending' | 'imported' |
    // 'rejected') can only ever be flipped away from 'pending' by a
    // signed-in team member (isAllowedUser()), not by the public
    // submitter, so a link can't be used to un-lock itself after the app
    // has already locked it.
    // A trial's own share link/QR code for external (no-login) sensory
    // evaluation (see the "Share External Evaluation" button in trials.js
    // and the standalone evaluate.html/evaluate.js page it points to).
    // Token-keyed exactly like /pendingSubmissions above, but the doc holds
    // a SNAPSHOT of only what a guest evaluator needs (product list,
    // photos, criteria) rather than the real /trials doc -- a guest link
    // must never be able to read another evaluator's scores/comments, this
    // trial's Improvement Guidelines notes, or any other team-only field,
    // so it's never given read access to /trials at all. expiresAt (set by
    // the team member's own client to createdAt + 24h) is enforced here
    // server-side too, not just hidden client-side, so a guest tab left
    // open past expiry can't still write in.
    match /evaluationLinks/{token} {
      allow get: if true;
      allow list: if isAllowedUser();
      allow create, update, delete: if isAllowedUser();
    }
    // One doc per guest submission, id'd by a fresh random token the guest
    // page generates itself on load (never coordinated with a server) --
    // that's what lets any number of people open the exact same shared
    // link/QR at once and each land on their own independent doc with no
    // collision, instead of overwriting each other or needing a freshly
    // "rotated" code per scan. A response can only be created against a
    // still-live (non-expired) /evaluationLinks doc, checked server-side
    // via expiresAt on that doc -- never against a real /trials doc
    // directly, and a guest can never read back, list, or edit ANY
    // response (their own or anyone else's) once submitted, only create
    // one. A team member reviews and imports each response from inside
    // the app (see "Import" in the Share External Evaluation panel),
    // same reviewed-before-it-counts shape as /pendingSubmissions ->
    // /projects above -- imported flips to true only from that review
    // step, never settable by the public create.
    match /evaluationResponses/{responseId} {
      allow get, list: if isAllowedUser();
      allow create: if request.resource.data.linkToken is string
        && exists(/databases/$(database)/documents/evaluationLinks/$(request.resource.data.linkToken))
        && get(/databases/$(database)/documents/evaluationLinks/$(request.resource.data.linkToken)).data.expiresAt > request.time.toMillis()
        && request.resource.data.imported == false;
      allow update, delete: if isAllowedUser();
    }
    match /pendingSubmissions/{token} {
      // Split from a single `read` on purpose: the public page only ever
      // fetches ONE doc it already has the token for (a "get"), it never
      // needs to enumerate the collection -- so `list` (any query across
      // /pendingSubmissions) stays team-only, closing off the one way an
      // unauthenticated visitor with the public Firebase config could
      // otherwise read every submission at once by querying the
      // collection directly instead of going through this app's UI.
      allow get: if true;
      allow list: if isAllowedUser();
      allow create: if request.resource.data.submissionStatus == 'pending';
      allow update: if isAllowedUser()
        || (resource.data.submissionStatus == 'pending' && request.resource.data.submissionStatus == 'pending');
      // Any approved team member can delete a submission (e.g. junk/spam
      // requests) from the Reviewing Submission panel -- same access
      // level as reviewing/importing one, not restricted to the admin
      // the way deleting a real /projects doc is, since this is just a
      // draft request that never became company data.
      allow delete: if isAllowedUser();
    }
  }
}
